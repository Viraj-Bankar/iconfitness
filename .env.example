# ============================================================
# ICON FITNESS — Environment Variables Configuration
# ============================================================

# ------------------------------------------------------------
# 1. Supabase Persistent Database & Storage Configuration
# ------------------------------------------------------------
# Create a free project at https://supabase.com
# Execute the SQL scripts in:
#   - supabase/migrations/20261112000000_create_reviews_table.sql
#   - supabase/migrations/20261112010000_create_gallery_and_storage.sql
# Retrieve Project URL & Anon Key from: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. Owner Gallery Portal Authorization
# ------------------------------------------------------------
# The verified owner email authorized to access /admin/gallery.
# In Supabase: Create user in Authentication -> Users with this email.
# Passwords must NEVER be stored in frontend environment files or code.
VITE_OWNER_EMAIL=owner@iconfitness.com

# ------------------------------------------------------------
# 3. Google Business Profile & Places Integration
# ------------------------------------------------------------
# Google Place ID for ICON FITNESS Moshi
# Find via: https://developers.google.com/maps/documentation/places/web-service/place-id
VITE_GOOGLE_PLACE_ID=ChIJMVHC8RPimpriChinchwad

# Direct Google Review Submission URL (optional, defaults to https://search.google.com/local/writereview?placeid=<PLACE_ID>)
VITE_GOOGLE_WRITE_REVIEW_URL=https://search.google.com/local/writereview?placeid=MVHC+8R

# Optional server-side proxy endpoint to fetch live Google Reviews without browser CORS issues
VITE_GOOGLE_REVIEWS_PROXY_URL=https://your-backend-api.com/api/google-reviews
VITE_GOOGLE_PLACES_API_KEY=AIzaSy...
